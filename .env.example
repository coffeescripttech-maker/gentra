# Naga-Gentra — environment variables
# Copy this file to `.env` and fill in real values.

# Mapbox access token — powers the in-app map (Mapbox GL JS inside a WebView).
#   Get one at https://account.mapbox.com/access-tokens/ (create a public "pk.*" token).
# A missing token does NOT break the app: the map falls back to a "Nearby drivers" list.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google Maps API key — only used when building a native dev build
# (npx expo prebuild + expo run:android). Ignored in Expo Go.
#   - Android: create a key in Google Cloud Console, enable "Maps SDK for Android".
#   - iOS: enable "Maps SDK for iOS" (or skip — Expo Go uses Apple Maps).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
